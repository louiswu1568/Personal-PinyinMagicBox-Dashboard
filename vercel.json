{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "data/questions.json",
          "data/english_questions.json",
          "data/math_questions.json",
          "data/multiplication_questions.json",
          "templates/**",
          "static/**",
          "scripts/generate_weekly_report.py"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}
